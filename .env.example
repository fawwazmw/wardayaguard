# Copy to .env and adjust. Never commit .env.

# API server
PORT=4000
NODE_ENV=development

# SQLite file used by the API. Relative paths resolve from the repo root.
DATABASE_PATH=.data/wardaya.sqlite

# Enables /api/test/* routes. Never enable outside tests.
ALLOW_TEST_ROUTES=0

# Used by Playwright. The API project points at this address.
API_BASE_URL=http://127.0.0.1:4000

# Storefront (added when the UI lands)
# BASE_URL=http://127.0.0.1:5173
