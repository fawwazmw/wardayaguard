{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/api/src/**/*.ts", "tests/**/*.ts", "playwright.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results", ".data"]
}
